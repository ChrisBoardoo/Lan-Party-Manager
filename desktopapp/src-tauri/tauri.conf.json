{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lan Party Manager",
  "version": "1.3.2",
  "identifier": "net.crosswax.lpmdesktop",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lan Party Manager",
        "width": 1456,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "scrollBarStyle": "fluentOverlay"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQkQ1QUM1N0NEN0I1MDYKUldRR3RkZDh4VnE5MnZkTXErRFg3cTdpbDVlTU83YlNWcTgzaFlWOEVQV1lhYmxidHNzWksramcK",
      "endpoints": [
        "https://lanpartymanager.com/assets/desktop/latest.json"
      ]
    }
  }
}
